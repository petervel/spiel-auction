// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  engineType      = "client"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                Int         @id @default(autoincrement())
  name              String?
  email             String?     @unique
  bggUsername       String?
  accessLevel       AccessLevel @default(NORMAL)
  createdAt         DateTime    @default(now())
  lastSeenAt        DateTime?
  googleId          String?     @unique
  currentUserFairId Int?
  currentUserFair   UserFair?   @relation("CurrentUserFair", fields: [currentUserFairId], references: [id])

  notifyOnOutbid             Boolean @default(true)
  notifyOnNewBid             Boolean @default(true)
  notifyOnAuctionWon         Boolean @default(true)
  notifyOnWishlistItemListed Boolean @default(true)
  notifyOnMeetupReminder     Boolean @default(true)

  // Days this user expects to be trading at the fair, used to fill in the
  // [day] token in their geekmail templates below (joined as "Thursday or
  // Friday" etc. - see frontend's buildDayText). Stored as JSON rather than
  // a join table since it's a handful of values with no need to query by
  // day. Template text is nullable (falls back to a hardcoded default in
  // frontend code) rather than defaulted here, since the default contains
  // newlines/placeholder tokens that are easier to keep in application code.
  preferredTradeDays    Json?
  sellerMessageTemplate String? @db.Text
  buyerMessageTemplate  String? @db.Text

  fairs            UserFair[]
  likedItems       UserLikedItem[]
  dismissedItems   UserDismissedItem[]
  wishlistItems    UserWishlistItem[]
  PushSubscription PushSubscription[]
  bggVerifications BggVerification[]
}

model MagicLinkToken {
  id        Int       @id @default(autoincrement())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model UserFair {
  id       Int  @id @default(autoincrement())
  user     User @relation(fields: [userId], references: [id])
  userId   Int
  fair     Fair @relation(fields: [fairId], references: [id])
  fairId   Int
  bookmark Int?

  // Meetup spot on the trade-floor grid ("A1".."E8") plus how to find/
  // recognize them there - per fair, like bookmark.
  locationSquare      String?
  locationDescription String? @db.Text

  // back relation so we can find all users with this as their "current"
  currentUsers User[] @relation("CurrentUserFair")

  @@unique([userId, fairId])
}

// Kept off User rather than a field on it so two different app accounts
// can each independently claim/verify the same real-world BGG username
// (e.g. a couple sharing one BGG account). Unique on (userId, bggUsername)
// rather than just userId, so switching away from a verified username and
// back later doesn't lose that verification - each username a user has
// ever claimed keeps its own record.
model BggVerification {
  id          Int       @id @default(autoincrement())
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
  bggUsername String
  hash        String
  confirmed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  @@unique([userId, bggUsername])
}

model UserLikedItem {
  id     Int  @id @default(autoincrement())
  user   User @relation(fields: [userId], references: [id])
  userId Int
  fair   Fair @relation(fields: [fairId], references: [id])
  fairId Int  @default(1)
  item   Item @relation(fields: [itemId], references: [id])
  itemId Int

  @@unique([userId, itemId])
}

// "I don't want to see this on my Outbid & Liked page anymore" - separate
// from UserLikedItem (liking and dismissing are independent, not opposites:
// dismissing an auto-liked outbid item shouldn't need to un-like it, and a
// dismissal shouldn't block a genuine future like). Per app account, not
// per BggVerification-shared BGG username - this is a personal UI
// preference, not a fact about the real bidder, so it's never fanned out
// to other accounts sharing that username (contrast usersByBggUsername.ts).
model UserDismissedItem {
  id          Int      @id @default(autoincrement())
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
  item        Item     @relation(fields: [itemId], references: [id])
  itemId      Int
  // Bumped on every (re-)dismiss. /api/outbids only honors this dismissal
  // for comments already posted by now - a bid the dismissing user places
  // afterwards brings the item back, since dismissing it was a statement
  // about the fight as it stood then, not a standing wish to never see
  // this item again regardless of what they do next.
  dismissedAt DateTime @default(now())

  @@unique([userId, itemId])
}

enum Day {
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// A planned in-person handoff between one buyer and one seller, covering
// every item currently being exchanged between that exact pair in this
// fair - not one row per item. buyerUsername/sellerUsername are plain BGG
// usernames (like Item.username/highestBidder), not FKs to User - a
// counterpart may never have an app account at all, and the pair's
// identity has to survive either side's own User.bggUsername changing
// later. If the same two people are both buying from and selling to each
// other, that's two separate rows (one per direction), not merged.
// location/time default to the venue's own "Hall 1A, 15:00" convention
// (seen verbatim in many sellers' own listings) but either side can
// override them; day has no default since the user picks it from
// scratch. updatedAt is the "last edited" tracking, shared by both
// parties since either can write to this same row. *Completed/
// *CompletedAt are per-side (not reused from updatedAt) so each party can
// mark the trade done from their own perspective independently - one side
// ticking it off doesn't tick it for the other, and the Completed section
// sorts by "most recently completed" without that order being disturbed by
// someone later tweaking the day/time/location of an already-completed
// meetup.
model Meetup {
  id                Int       @id @default(autoincrement())
  fair              Fair      @relation(fields: [fairId], references: [id])
  fairId            Int
  buyerUsername     String
  sellerUsername    String
  day               Day?
  location          String    @default("Hall 1A")
  time              String    @default("15:00")
  buyerCompleted    Boolean   @default(false)
  buyerCompletedAt  DateTime?
  sellerCompleted   Boolean   @default(false)
  sellerCompletedAt DateTime?
  // Whether this side has sent their geekmail to the other - checked off
  // manually, or automatically by MessageComposeDialog's "Open in BGG"
  // (see POST /api/meetups's messageSent handling). Purely informational,
  // never required for anything else on the row.
  buyerMessageSent  Boolean   @default(false)
  sellerMessageSent Boolean   @default(false)
  // Private per-side notes - each party only ever sees/edits their own
  // column (API resolves "mine" from role), never the other party's.
  buyerNotes        String?   @db.Text
  sellerNotes       String?   @db.Text
  // Whichever side's POST last touched this row - buyerUsername or
  // sellerUsername, never a third party (see the defense-in-depth
  // qualifyingItem check in POST /api/meetups).
  lastEditedBy      String?
  // Set via POST /api/meetups/custom - a meetup with this counterpart
  // that isn't backed by any real bid relationship (or an addendum on one
  // that is, e.g. "also bringing you a gift"). customDescription is
  // mandatory whenever isCustom is true, but not enforced at the DB
  // level since Prisma/MySQL can't express "required iff" declaratively.
  isCustom          Boolean   @default(false)
  customDescription String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([fairId, buyerUsername, sellerUsername])
}

// A BGG "thing" (board game, expansion, etc), keyed by its BGG object id.
// Populated lazily from whichever source sees it first - a geeklist item
// being imported, or a user's BGG collection being imported for their
// wishlist - so only the fields both of those sources actually provide
// belong here.
model BggObject {
  objectId      Int    @id
  objectType    String
  objectSubtype String
  objectName    String @db.Text

  wishlistedBy UserWishlistItem[]
}

model UserWishlistItem {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id])
  userId    Int
  object    BggObject @relation(fields: [objectId], references: [objectId])
  objectId  Int
  createdAt DateTime  @default(now())

  @@unique([userId, objectId])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  // Bounded rather than @db.Text so MySQL can put a unique index on it -
  // browser push endpoints are ~150-300 chars, 512 is safe headroom.
  endpoint  String   @unique @db.VarChar(512)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Fair {
  id                   Int        @id @default(autoincrement())
  name                 String     @unique
  status               FairStatus @default(ACTIVE)
  // status decides whether the importer fetches/updates this fair; hidden
  // decides whether normal users see it as a selectable option in the UI.
  hidden               Boolean    @default(false)
  // The real-world date this fair is held - specifically its official
  // opening day (always a Thursday for Essen Spiel, though the calendar
  // date moves every year). Used both as the reference year when resolving
  // imprecise end-date notations in item bodies (e.g. "Auction ends: Thu
  // 17 Nov" has no year - without this, parsing always assumed the current
  // year, which is wrong for any fair other than the one happening right
  // now), and by meetupReminderNotifier.ts to resolve "today" to the
  // correct MeetupDay by calendar-date offset from this Thursday
  // (WEDNESDAY = eventDate - 1, for early-trader access, through SUNDAY =
  // eventDate + 3) instead of just matching on weekday name, which would
  // otherwise fire on every matching weekday year-round, not just fair
  // week.
  eventDate            DateTime
  geeklistId           Int        @unique
  lastUpdated          Int        @default(0)
  lastResult           JobResult  @default(NONE)
  startedAt            Int        @default(0)
  list                 List?      @relation(fields: [listId], references: [id])
  listId               Int?       @unique
  latestFile           String?
  // Newest RSS activity feed pubDate (unix seconds) imported so far by the
  // RSS fast path (updateRssData.ts) - also read by xml-fetcher to decide
  // how many RSS pages deep it needs to paginate each cycle to catch up.
  rssLastSeenTimestamp Int        @default(0)

  UserFair   UserFair[]
  likedItems UserLikedItem[]
  meetups    Meetup[]
}

model List {
  id            Int           @unique
  fair          Fair?
  title         String
  username      String
  postDate      DateTime
  postTimestamp Int
  editDate      DateTime
  editTimestamp Int
  thumbs        Int
  itemCount     Int
  description   String        @db.Text
  tosUrl        String
  comments      ListComment[]
  items         Item[]

  lastSeen Int     @default(0)
  deleted  Boolean @default(false)
}

model Item {
  id     Int  @unique
  list   List @relation(fields: [listId], references: [id])
  listId Int

  objectType    String
  objectSubtype String
  objectId      Int
  objectName    String @db.Text

  username      String
  postDate      DateTime
  postTimestamp Int
  editDate      DateTime
  editTimestamp Int
  thumbs        Int
  imageId       Int

  body String @db.Text

  comments ItemComment[]

  // Derived data
  language  String? @db.Text
  condition String? @db.Text

  startingBid Int?
  softReserve Int?
  hardReserve Int?
  binPrice    Int?

  auctionEnd     String? @db.Text
  auctionEndDate String? @db.Text

  hasBids       Boolean  @default(false)
  isSold        Boolean  @default(false)
  isEnded       Boolean  @default(false)
  itemType      ItemType @default(GAME)
  currentBid    Int?
  highestBidder String?

  lastSeen         Int                 @default(0)
  deleted          Boolean             @default(false)
  likedByUsers     UserLikedItem[]
  dismissedByUsers UserDismissedItem[]

  @@index([listId, deleted, id])
  @@index([listId, deleted, username])
  @@index([listId, deleted, highestBidder])
  @@index([deleted])
}

model ListComment {
  list          List     @relation(fields: [listId], references: [id])
  listId        Int
  username      String
  date          String
  postDate      DateTime
  postTimestamp Int
  editDate      DateTime
  editTimestamp Int
  thumbs        Int      @default(0)
  text          String   @db.Text

  lastSeen Int     @default(0)
  deleted  Boolean @default(false)

  @@unique([listId, username, postTimestamp])
}

model ItemComment {
  listId        Int
  item          Item     @relation(fields: [itemId], references: [id])
  itemId        Int
  username      String
  date          String
  postDate      DateTime
  postTimestamp Int
  editDate      DateTime
  editTimestamp Int
  thumbs        Int      @default(0)
  text          String   @db.Text
  isBin         Boolean  @default(false)
  bid           Int?
  oldBid        Int?

  lastSeen Int     @default(0)
  deleted  Boolean @default(false)

  @@unique([itemId, username, postTimestamp])
  @@index([listId])
  @@index([deleted])
  @@index([username, deleted])
}

enum FairStatus {
  ACTIVE
  ARCHIVED
}

enum JobResult {
  NONE
  FAILURE
  SUCCESS
  RUNNING
}

enum ItemType {
  GAME
  PROMO
  OTHER
}

enum AccessLevel {
  ADMIN
  NORMAL
  MODERATOR
}
